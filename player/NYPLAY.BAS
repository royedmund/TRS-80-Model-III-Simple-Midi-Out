10 REM NYPLAY/BAS - MODEL III LDOS 5.3.120 REM PLAYS NYSTATE/DAT VIA 9600 BAUD MIDI BRIDGE30 REM Q = STOP; DO NOT USE BREAK (BASIC ABORTS)40 CLS:PRINT "TRS-80 / YAMAHA EMT-10 MIDI DEMO"50 INPUT "CLOCK TICKS/SEC (25 OR 30)";HZ60 IF HZ<>25 AND HZ<>30 THEN 5070 INPUT "DATA FILE (E.G. NYSTATE/DAT:0)";F$80 OPEN "I",1,F$90 OUT 232,0:OUT 233,238:OUT 234,111100 PRINT "PLAYING - PRESS Q TO STOP"110 EL=0:LT=PEEK(17032)120 IF EOF(1) THEN 300130 INPUT#1,MS,ST,D1,D2140 IF MS<0 THEN 300150 TG=INT(MS*HZ/1000+.5)160 GOSUB 500:IF Q=1 THEN 300170 IF EL<TG THEN 160180 BY=ST:GOSUB 600190 BY=D1:GOSUB 600200 IF D2<0 THEN 120210 BY=D2:GOSUB 600:GOTO 120300 REM PANIC - PEDALS OFF AND ALL NOTES OFF CH 1310 CLOSE 1320 BY=176:GOSUB 600:BY=64:GOSUB 600:BY=0:GOSUB 600330 BY=176:GOSUB 600:BY=123:GOSUB 600:BY=0:GOSUB 600340 PRINT "PLAYBACK ENDED":END500 REM ELAPSED LDOS TIMER TICKS (4288 HEX)510 NT=PEEK(17032):DF=NT-LT:IF DF<0 THEN DF=DF+256520 EL=EL+DF:LT=NT:K$=INKEY$:Q=0530 IF K$="Q" OR K$="q" THEN Q=1540 RETURN600 REM SEND RAW BYTE - UART TRANSMIT HOLDING EMPTY610 FOR WT=1 TO 1000620 IF (INP(234) AND 64)<>0 THEN 650630 NEXT WT640 CLOSE:PRINT "UART TIMEOUT - CHECK SERIAL BOARD":END650 OUT 235,BY:RETURN